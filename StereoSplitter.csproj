<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <AssemblyName>SplitterGUI</AssemblyName>
    <RootNamespace>StereoSplitter</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <Deterministic>true</Deterministic>
    <Platforms>AnyCPU</Platforms>
    <Prefer32Bit>false</Prefer32Bit>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup>
    <Version>2.1.0</Version>
    <FileVersion>2.1.0.0</FileVersion>
    <AssemblyVersion>2.1.0.0</AssemblyVersion>
    <Product>Audio Splitter</Product>
    <Company>Audio Splitter</Company>
    <Copyright>Copyright © 2026</Copyright>
  </PropertyGroup>

  <!-- tools/ 下是开发期工具 (布局量测等), 各自独立成项目; SDK 默认 glob 会把它们扫进主工程,
       所以要显式排除, 否则会多出一个 Main 并与启动对象冲突。 -->
  <ItemGroup>
    <Compile Remove="tools\**" />
    <None Remove="tools\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="NAudio.Core" Version="2.2.1" GeneratePathProperty="true" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <!-- 单文件兜底：同目录缺少 NAudio dll 时由 Program.AssemblyResolve 从内嵌资源加载。
       资源名必须与 AssemblyResolve 里的 name + ".dll" 完全一致。 -->
  <ItemGroup>
    <EmbeddedResource Include="$(PkgNAudio_Core)\lib\netstandard2.0\NAudio.Core.dll"
                      LogicalName="NAudio.Core.dll"
                      Condition="Exists('$(PkgNAudio_Core)\lib\netstandard2.0\NAudio.Core.dll')" />
    <EmbeddedResource Include="$(PkgNAudio_Wasapi)\lib\netstandard2.0\NAudio.Wasapi.dll"
                      LogicalName="NAudio.Wasapi.dll"
                      Condition="Exists('$(PkgNAudio_Wasapi)\lib\netstandard2.0\NAudio.Wasapi.dll')" />
  </ItemGroup>

  <!-- F-29: 资源缺失必须是构建错误，不再是沉默跳过/只警告。
       两个 dll 都要断言: 少一个，单文件分发在缺同目录 dll 的环境就会加载失败。 -->
  <Target Name="CheckEmbeddedAudioResources" AfterTargets="Build">
    <Error Condition="'$(PkgNAudio_Core)' == '' Or !Exists('$(PkgNAudio_Core)\lib\netstandard2.0\NAudio.Core.dll')"
           Text="NAudio.Core.dll 未解析或未找到（单文件分发的内嵌资源缺失）: $(PkgNAudio_Core)" />
    <Error Condition="'$(PkgNAudio_Wasapi)' == '' Or !Exists('$(PkgNAudio_Wasapi)\lib\netstandard2.0\NAudio.Wasapi.dll')"
           Text="NAudio.Wasapi.dll 未解析或未找到（单文件分发的内嵌资源缺失）: $(PkgNAudio_Wasapi)" />
  </Target>

</Project>
